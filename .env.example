# Vitiwai portal - local development.
# Copy to .env. Every value here is for a local container stack and is not a secret.
#
# Ports were checked on 2026-09-21 with `npm run preflight`: each one is free and
# bindable on the development machine. 55432 and 55433 are NOT usable there - they
# sit inside the Windows reserved range 55403-55502.
#
# Measured with `docker stats --no-stream` on 2026-09-21, all six services up:
#   odoo 76.8 MiB, odoo-db 48.1 MiB, portal-db 34.1 MiB, meilisearch 66.6 MiB,
#   mock-gateway 20.1 MiB, mailpit 7.8 MiB  ->  253 MiB total.

PORT_PORTAL=3000
PORT_ODOO=8069
PORT_PORTAL_DB=15432
PORT_ODOO_DB=15433
PORT_MEILI=7700
PORT_GATEWAY=8091
PORT_MAILPIT_SMTP=1025
PORT_MAILPIT_WEB=8025

ODOO_URL=http://localhost:8069
ODOO_DB=vitiwai
ODOO_USER=admin
ODOO_PASSWORD=admin

MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=vitiwai_local_dev_key_not_a_secret

GATEWAY_URL=http://localhost:8091

PORTAL_DATABASE_URL=postgres://portal:portal@localhost:15432/portal

SMTP_HOST=localhost
SMTP_PORT=1025
