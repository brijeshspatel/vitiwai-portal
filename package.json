{
  "name": "vitiwai-portal",
  "version": "0.4.0",
  "private": true,
  "description": "Vitiwai Utilities customer self-service portal. Synthetic data only.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --project component",
    "test:watch": "vitest --project unit",
    "test:contract": "vitest run --project contract",
    "test:integration": "vitest run --project contract",
    "preflight": "node scripts/check-ports.mjs",
    "seed": "node scripts/seed.mjs",
    "stack:up": "npm run preflight && docker compose up -d && npm run init:odoo && npm run migrate",
    "stack:down": "docker compose down",
    "stack:reset": "docker compose down -v",
    "init:odoo": "node scripts/init-odoo.mjs",
    "migrate": "node scripts/migrate.mjs",
    "demo:credential": "node scripts/demo-credential.mjs",
    "portal:free": "node scripts/restart-portal.mjs"
  },
  "dependencies": {
    "meilisearch": "0.62.0",
    "next": "16.3.5",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "jsdom": "30.1.0",
    "prettier": "3.9.8",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
